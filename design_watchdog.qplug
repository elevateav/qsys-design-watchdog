    { Name = "Rescan",                  ControlType = "Button",    ButtonType = "Trigger",                                          Count = 1 },
    { Name = "APPLY",                   ControlType = "Button",    ButtonType = "Trigger",                                          Count = 1 },
    { Name = "Debug",                   ControlType = "Button",    ButtonType = "Toggle",                                           Count = 1 },
  }
  return ctrls
end

function GetPages(props)
  pages = {}
  table.insert(pages, { name = "Monitor" })
  table.insert(pages, { name = "Setup" })
  table.insert(pages, { name = "Update" })
  return pages
end

