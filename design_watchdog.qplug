    { Name = "Update URL",              ControlType = "Text",                                                                       Count = 1 },
    { Name = "Update Passcode",         ControlType = "Text",                                                                       Count = 1 },
    { Name = "Latch Until Acknowledged",ControlType = "Button",    ButtonType = "Toggle",                                           Count = 1 },
    { Name = "Email Enable",            ControlType = "Button",    ButtonType = "Toggle",                                           Count = 1 },
    { Name = "SMTP2GO API Key",         ControlType = "Text",                                                                       Count = 1 },
    { Name = "Email From",              ControlType = "Text",                                                                       Count = 1 },
