-- Design Watchdog - Elevate AV
-- Logs design redeploys (with a control-level diff) and live control edits on a
-- running core. Auto-discovers every component with Script Access; no watch
-- list needed. Drives BANNER components red/amber/green, feeds a changelog
-- file on Acknowledge. See design-watchdog-plugin.md for setup and caveats.

PluginInfo = {
  Name = "Elevate AV~Design Watchdog",
  Version = "1.6.0",
  BuildVersion = "1.6.0.0",
  Id = "com.elevateav.designwatchdog",
  Author = "Elevate AV",
  Description = "Logs design redeploys and live control edits with timestamps, diffs, banners, changelog output, Reflect proxy push, and optional email alerts.",
  ShowDebug = true,
  -- Managed-plugin fields, kept for the record: field set verified against
  -- QSC's Samsung MDC / Shure MXW managed plugins (2026-09). Designer reads
  -- them (Reflect.Types resolves at design time) but only honors IsManaged on
  -- QSC-signed plugins (the DIGITAL SIGNATURE block) - tested and confirmed
  -- the Is Managed property never appears on an unsigned .qplug. Harmless to
  -- keep; Reflect integration goes through a Monitoring Proxy instead (see
  -- the Proxy Name setting).
  Manufacturer = "Elevate AV",
  Model = "Design Watchdog",
  IsManaged = true,
  Type = Reflect and Reflect.Types.Other or 0,
}

function GetColor(props)
  return {88, 88, 96}
end

function GetPrettyName(props)
  return "Design Watchdog " .. PluginInfo.Version
end

function GetProperties()
  props = {
    { Name = "Instance Name", Type = "string", Value = "Watchdog" },
  }
  return props
end

function GetControls(props)
  ctrls = {
    { Name = "Status",                  ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output", UserPin = true,  Count = 1 },
    { Name = "Watched",                 ControlType = "Indicator", IndicatorType = "Text",                                          Count = 1 },
    { Name = "Last Change",             ControlType = "Indicator", IndicatorType = "Text",   PinStyle = "Output", UserPin = true,  Count = 1 },
    { Name = "Change Count",            ControlType = "Indicator", IndicatorType = "Text",   PinStyle = "Output", UserPin = true,  Count = 1 },
    { Name = "Unacknowledged",          ControlType = "Indicator", IndicatorType = "LED",    PinStyle = "Output", UserPin = true,  Count = 1 },
    { Name = "Log",                     ControlType = "Indicator", IndicatorType = "Text",                                          Count = 1 },
    { Name = "Change Notes",            ControlType = "Text",                                                                       Count = 1 },
    { Name = "Technician",              ControlType = "Text",                                                                       Count = 1 },
    { Name = "Acknowledge",             ControlType = "Button",    ButtonType = "Trigger",   PinStyle = "Input",  UserPin = true,  Count = 1 },
    { Name = "Clear Log",               ControlType = "Button",    ButtonType = "Trigger",                                          Count = 1 },
    { Name = "Maintenance Mode",        ControlType = "Button",    ButtonType = "Toggle",    PinStyle = "Input",  UserPin = true,  Count = 1 },
    { Name = "Banner",                  ControlType = "Button",    ButtonType = "Trigger",                                          Count = 1 },
    { Name = "Site Name",               ControlType = "Text",                                                                       Count = 1 },
